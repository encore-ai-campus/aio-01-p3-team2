DATABASE_URL=
ENABLE_FAULT_INJECTION=false
APPROVED_ACTOR_IDS=liveops01
OPERATOR_ACTOR_ID=liveops01
WORKFLOW_ENGINE=mock
MCP_URL=http://127.0.0.1:8010/mcp
# Set only for WORKFLOW_ENGINE=agent_live (legacy alias: backend_b_live)
OPENAI_MODEL=
# Live LLM modes require measured usage, an explicit provider price snapshot, and hard limits.
CANONICAL_PLANNING_MODE=deterministic
LLM_MAX_INPUT_TOKENS=
LLM_MAX_OUTPUT_TOKENS=
LLM_MAX_COST_USD=
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=
LLM_PRICING_VERSION=
LLM_COST_CURRENCY=USD
# Generate a Fernet key locally; keep it in the environment/secret store only.
LLM_RECORD_ENCRYPTION_KEY=
