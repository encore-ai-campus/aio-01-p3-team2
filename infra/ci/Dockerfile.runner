# Local Linux rehearsal only. GitHub jobs install the same CI lock on hosted runners.
FROM node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 AS node
FROM docker:28-cli@sha256:625d9431a9f54c5a2bc90f24f0e1c3d55b1349fd857dd85035f98c2c9acbdd4d AS docker
FROM python:3.11-slim-bookworm@sha256:0a310eeecf4e1f5a0743f9a6520c90c88d089c903ca5fd283f501e3a805f5f89
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
COPY --from=docker /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker /usr/local/libexec/docker/cli-plugins /usr/local/libexec/docker/cli-plugins
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates && rm -rf /var/lib/apt/lists/* && node /usr/local/lib/node_modules/npm/bin/npm-cli.js install -g pnpm@10.33.0
COPY infra/aws/requirements.ci.lock /tmp/requirements.ci.lock
RUN pip install --no-cache-dir --require-hashes -r /tmp/requirements.ci.lock
WORKDIR /opt/browser
COPY frontend-web/package.json frontend-web/pnpm-lock.yaml frontend-web/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile && pnpm exec playwright install --with-deps chromium
WORKDIR /workspace
ENV PYTHONDONTWRITEBYTECODE=1
CMD ["sleep", "infinity"]
