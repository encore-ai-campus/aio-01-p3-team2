# syntax=docker/dockerfile:1
FROM python:3.11-slim-bookworm@sha256:0a310eeecf4e1f5a0743f9a6520c90c88d089c903ca5fd283f501e3a805f5f89 AS dependencies
WORKDIR /build
COPY infra/aws/requirements.application.lock ./requirements.lock
RUN python -m venv /opt/venv && /opt/venv/bin/pip install --no-cache-dir --require-hashes -r requirements.lock
ARG RDS_CA_SHA256=913fb5b814f17af79d4c1622584a8d0ceddf5b0d76fe353d0c7d1186cdd6b229
RUN python -c 'import hashlib,os,urllib.request; data=urllib.request.urlopen("https://truststore.pki.rds.amazonaws.com/ap-northeast-2/ap-northeast-2-bundle.pem",timeout=30).read(); assert hashlib.sha256(data).hexdigest()==os.environ["RDS_CA_SHA256"], "RDS CA checksum changed: review before rebuilding"; open("/build/rds-ca.pem","wb").write(data)'

FROM python:3.11-slim-bookworm@sha256:0a310eeecf4e1f5a0743f9a6520c90c88d089c903ca5fd283f501e3a805f5f89
ENV PATH=/opt/venv/bin:$PATH PYTHONPATH=/opt/app PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 AWS_EC2_METADATA_DISABLED=true
WORKDIR /opt/app
COPY --from=dependencies /opt/venv /opt/venv
COPY --from=dependencies /build/rds-ca.pem /opt/certs/rds-ca.pem
COPY backend/__init__.py backend/__init__.py
COPY backend/app backend/app
COPY backend/data backend/data
COPY backend/sql backend/sql
COPY backend/scripts backend/scripts
COPY backend/tests backend/tests
COPY mcp_server mcp_server
COPY infra/aws/scripts/start-service.sh /opt/start-service.sh
RUN groupadd --gid 10001 eventquest && useradd --uid 10001 --gid 10001 --no-create-home eventquest && mkdir -p /var/lib/eventquest/fault-lab && chown 10001:10001 /var/lib/eventquest/fault-lab && chmod 555 /opt/start-service.sh
USER 10001:10001
EXPOSE 8000 8010
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 CMD ["python", "-m", "backend.app.deployment.healthcheck"]
ENTRYPOINT ["/bin/sh", "/opt/start-service.sh"]
