# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 AS build
RUN npm install --global pnpm@10.33.0
WORKDIR /build
COPY frontend-web/package.json frontend-web/pnpm-lock.yaml frontend-web/
COPY frontend-web/pnpm-workspace.yaml frontend-web/
COPY demo-game/package.json demo-game/pnpm-lock.yaml demo-game/
COPY demo-game/pnpm-workspace.yaml demo-game/
RUN cd frontend-web && pnpm install --frozen-lockfile && cd ../demo-game && pnpm install --frozen-lockfile
COPY frontend-web frontend-web
COPY demo-game demo-game
RUN cd frontend-web && pnpm build && cd ../demo-game && pnpm build

FROM caddy:2-alpine@sha256:d8542f48d34a9cf4e4c11a478865229840e87e4c96ea3f439101f31a5d35f75f
COPY --from=build /build/frontend-web/dist /srv/plan
COPY --from=build /build/demo-game/dist /srv/game
COPY infra/aws/Caddyfile /etc/caddy/Caddyfile
COPY infra/aws/Caddyfile.plan /etc/caddy/Caddyfile.plan
COPY infra/aws/Caddyfile.game /etc/caddy/Caddyfile.game
COPY infra/aws/scripts/start-web.sh /opt/start-web.sh
RUN setcap -r /usr/bin/caddy && addgroup -g 10001 eventquest && adduser -D -H -u 10001 -G eventquest eventquest && mkdir -p /data /config && chown -R 10001:10001 /data /config && chmod 555 /opt/start-web.sh
USER 10001:10001
EXPOSE 8080 8443
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1:8080/health/live
ENTRYPOINT ["/bin/sh", "/opt/start-web.sh"]
