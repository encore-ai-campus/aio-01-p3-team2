@fault path /api/test /api/test/*
handle @fault {
	reverse_proxy {$FAULT_API_UPSTREAM} {
		header_up -Authorization
		header_up X-Eventquest-Proxy plan-web
		header_up X-Eventquest-Proxy-Key {$FAULT_PROXY_KEY}
		transport http {
			dial_timeout 5s
			response_header_timeout 180s
		}
	}
}
@api path /api /api/*
handle @api {
	reverse_proxy {$MAIN_API_UPSTREAM} {
		header_up -Authorization
		header_up X-Eventquest-Proxy plan-web
		header_up X-Eventquest-Proxy-Key {$MAIN_PROXY_KEY}
		transport http {
			dial_timeout 5s
			response_header_timeout 180s
		}
	}
}
handle {
	root * /srv/plan
	try_files {path} /index.html
	file_server
}
